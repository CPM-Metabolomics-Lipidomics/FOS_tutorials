# Rendered learnr tutorials. The index.Rmd is the source; the HTML is a build
# artifact produced by knitting it, and is regenerated by shiny-server at run
# time. Note this deliberately does NOT match FOS/index.html or
# FOS/<year>/index.html, which are hand-written overview pages.
FOS/*/*/index.html
FOS/*/*/index_files/

# Stray output from running R scripts against the tutorials
Rplots.pdf
