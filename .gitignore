.Rproj.user
.Rhistory
.RData
.Ruserdata

# Rendered learnr tutorials. The index.Rmd is the source; the HTML is a build
# artifact produced by knitting it, and is regenerated by learnr/shiny-server
# at run time. The hand-written overview pages in FOS/ are NOT matched.
inst/tutorials/*/index.html
inst/tutorials/*/index_files/

# Stray output from running R scripts against the tutorials
Rplots.pdf

# Merged tutorial generated by deploy_shinyapps.R; only the rsconnect
# deployment record is kept, so a redeploy updates the same app.
shinyapps/*
!shinyapps/rsconnect/
.claude/